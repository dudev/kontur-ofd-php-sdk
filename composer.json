{
    "name": "dudev/kontur-ofd-php-sdk",
    "description": "PHP SDK for the Kontur.OFD API (https://docs-ofd-api.kontur.ru/)",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "dudev"
        }
    ],
    "require": {
        "php": "^8.2",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "*",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dudev\\KonturOfdPhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dudev\\KonturOfdPhpSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
